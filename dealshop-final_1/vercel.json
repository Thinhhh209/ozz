{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/go/:id", "destination": "/api/go?id=:id" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/tiktok", "destination": "/tiktok.html" }
  ]
}
